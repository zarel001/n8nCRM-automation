{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	request_body {
		max_size 1MB
	}

	# Meta's webhook (GET verification + POST events) and an uptime probe. Nothing else is public.
	handle /webhook/whatsapp {
		reverse_proxy gate:8080
	}
	handle /healthz {
		reverse_proxy gate:8080
	}
	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	log {
		output stdout
		format json
	}
}
