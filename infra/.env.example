# Copy to infra/.env (chmod 600) and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# ── Public webhook address ────────────────────────────────────────────────────────────────────
# A hostname pointing at this VM (DNS A record), e.g. wa.mashsip.com.
# No domain yet? <public-ip-with-dashes>.sslip.io works, e.g. 129-146-12-34.sslip.io
PUBLIC_HOST=
# Let's Encrypt contact (expiry notices)
ACME_EMAIL=

# ── Database ──────────────────────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
N8N_DB_PASSWORD=
CRM_ADMIN_PASSWORD=
CRM_BOT_PASSWORD=

# ── n8n ───────────────────────────────────────────────────────────────────────────────────────
# BACK THIS UP somewhere safe (password manager). Losing it = losing every saved credential.
N8N_ENCRYPTION_KEY=

# ── Webhook gate ──────────────────────────────────────────────────────────────────────────────
# Meta app → App settings → Basic → App secret
META_APP_SECRET=
# Any random string; paste the same value into Meta's webhook "Verify token" field
META_VERIFY_TOKEN=
# Random; shared only between the gate and n8n
N8N_GATE_TOKEN=

# ── Backups (optional but recommended) ────────────────────────────────────────────────────────
# Encrypts scripts/backup.sh output. Store it with N8N_ENCRYPTION_KEY.
BACKUP_PASSPHRASE=

# ── Used by scripts/bootstrap.sh to create n8n credentials ────────────────────────────────────
# bootstrap.sh (re)creates the n8n credentials from these. You may delete them after setup, but
# add them back before re-running bootstrap.
# Permanent System User token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
ANTHROPIC_API_KEY=
